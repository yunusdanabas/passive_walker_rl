<!-- VLL Passive Walker Model for RL Training -->
<mujoco model="PassiveWalker_VLL">
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <asset>
    <texture name="ground_tex" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.8 0.8 0.8" rgb2="0.2 0.3 0.3"/>
    <material name="ground_mat" texture="ground_tex" texrepeat="20 20" reflectance="0.2"/>
    <material name="torso_mat" rgba="0.6 0.3 0.3 1"/>
    <material name="leg_mat" rgba="0.3 0.6 0.3 1"/>
    <material name="foot_mat" rgba="0.8 0.4 0.2 1"/>
  </asset>

  <worldbody>
    <!-- Ground plane -->
    <geom name="ground" type="plane" size="40 40 0.1" material="ground_mat"/>
    <light pos="10 0 30" dir="0 0 -1" diffuse="1 1 1" specular="0.5 0.5 0.5"/>
    <light pos="30 0 30" dir="0 0 -1" diffuse="1 1 1" specular="0.5 0.5 0.5"/>

    <!-- Torso with 3 DOF (x, z, pitch) -->
    <body name="torso" pos="0 0 1.3" euler="0 0 0">
      <joint name="slide_x" type="slide" axis="1 0 0"/>
      <joint name="slide_z" type="slide" axis="0 0 1"/>
      <joint name="pitch" type="hinge" axis="0 1 0"/>
      <geom name="torso_geom" type="sphere" size="0.1" mass="5" material="torso_mat"/>

      <!-- Left leg (rigidly attached) -->
      <body name="left_leg" pos="0 -0.125 -0.5" euler="0 0 0">
        <geom name="left_thigh" type="capsule" size="0.05 0.5" mass="1" material="leg_mat"/>
        <body name="left_foot" pos="0 0 -0.75">
          <joint name="left_knee" type="slide" pos="0 0 0.25" axis="0 0 -1" 
                 range="-0.50 0.50" damping="1.0"/>
          <geom name="left_shin" type="capsule" fromto="0 0 0 0 0 0.5"
                size="0.02" material="leg_mat" mass="0.05"/>
          <geom name="left_foot_geom" type="sphere" size="0.05" material="foot_mat" mass="0.1"/>
        </body>
      </body>

      <!-- Right leg (actuated hip) -->
      <body name="right_leg" pos="0 0.125 -0.5" euler="0 0 0">
        <joint name="hip" type="hinge" pos="0 0 0.5" axis="0 -1 0" damping="0.1"/>
        <geom name="right_thigh" type="capsule" size="0.05 0.5" mass="1" material="leg_mat"/>
        <body name="right_foot" pos="0 0 -0.75">
          <joint name="right_knee" type="slide" pos="0 0 0.25" axis="0 0 -1" 
                 range="-0.50 0.50" damping="1.0"/>
          <geom name="right_shin" type="capsule" fromto="0 0 0 0 0 0.5"
                size="0.02" material="leg_mat" mass="0.05"/>
          <geom name="right_foot_geom" type="sphere" size="0.05" material="foot_mat" mass="0.1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Neutral general actuators for PD control -->
    <general name="hip_act" joint="hip" gaintype="fixed" gainprm="1"
             biastype="affine" biasprm="0 0 0" ctrllimited="true" ctrlrange="-50 50"/>
    <general name="left_knee_act" joint="left_knee" gaintype="fixed" gainprm="1"
             biastype="affine" biasprm="0 0 0" ctrllimited="true" ctrlrange="-800 800"/>
    <general name="right_knee_act" joint="right_knee" gaintype="fixed" gainprm="1"
             biastype="affine" biasprm="0 0 0" ctrllimited="true" ctrlrange="-800 800"/>
  </actuator>
</mujoco>