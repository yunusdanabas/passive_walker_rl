# Byte-compiled / cache
__pycache__/
*.py[cod]

# Packaging
build/
dist/
*.egg-info/

# Experiment outputs (data, checkpoints, logs, plots). Only the README is tracked.
experiments/*
!experiments/README.md
data/
results/
checkpoints/
logs/
runs/
wandb/
MUJOCO_LOG.TXT

# Large binary artifacts (never commit; regenerate or store elsewhere)
*.pkl
*.pkl.gz
*.msgpack
*.pt
*.pth
*.eqx
*.npz
events.out.tfevents.*
# Small, reviewed test fixtures are the exception
!tests/data/*.npz

# Local handoff notes (cluster account details; the repository is public)
agent.md

# Environments and secrets
.env
.env.*
.venv/
venv/
.python-version

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.cursor/
.DS_Store
